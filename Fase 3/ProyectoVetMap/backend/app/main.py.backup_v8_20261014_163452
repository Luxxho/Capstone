from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from sqlalchemy import text

from .database import Base, engine
from .routers import (
    auth,
    admin,
    pets,
    reservations,
    clinic,
    store,
    payments,
    notifications,
    reports,
)


Base.metadata.create_all(bind=engine)


# =========================================================
# MIGRACIONES PEQUEÑAS
# =========================================================
# create_all() crea tablas nuevas, pero no agrega columnas
# a tablas que ya existen.
# =========================================================

with engine.begin() as connection:
    connection.execute(
        text(
            "ALTER TABLE users "
            "ADD COLUMN IF NOT EXISTS birth_date DATE"
        )
    )

    connection.execute(
        text(
            "ALTER TABLE users "
            "ADD COLUMN IF NOT EXISTS veterinary_id INTEGER "
            "REFERENCES veterinary_clinics(id) "
            "ON DELETE SET NULL"
        )
    )

    connection.execute(
        text(
            "ALTER TABLE users "
            "ADD COLUMN IF NOT EXISTS store_id INTEGER "
            "REFERENCES pet_stores(id) "
            "ON DELETE SET NULL"
        )
    )


    # Actividad de usuarios para el Inicio del administrador.
    connection.execute(
        text(
            "ALTER TABLE users "
            "ADD COLUMN IF NOT EXISTS last_login_at TIMESTAMP"
        )
    )

    connection.execute(
        text(
            "ALTER TABLE users "
            "ADD COLUMN IF NOT EXISTS last_seen_at TIMESTAMP"
        )
    )

    # Coordenadas para mapas demostrativos.
    connection.execute(
        text(
            "ALTER TABLE veterinary_clinics "
            "ADD COLUMN IF NOT EXISTS latitude DOUBLE PRECISION"
        )
    )
    connection.execute(
        text(
            "ALTER TABLE veterinary_clinics "
            "ADD COLUMN IF NOT EXISTS longitude DOUBLE PRECISION"
        )
    )
    connection.execute(
        text(
            "ALTER TABLE pet_stores "
            "ADD COLUMN IF NOT EXISTS latitude DOUBLE PRECISION"
        )
    )
    connection.execute(
        text(
            "ALTER TABLE pet_stores "
            "ADD COLUMN IF NOT EXISTS longitude DOUBLE PRECISION"
        )
    )

    # Horarios de recordatorio de medicamentos.
    connection.execute(
        text(
            "ALTER TABLE medications "
            "ADD COLUMN IF NOT EXISTS reminder_times TEXT"
        )
    )

    # Vinculo entre la reserva y los registros clinicos de esa atencion.
    for table_name in (
        "consultations",
        "vaccines",
        "medications",
        "prescriptions",
    ):
        connection.execute(
            text(
                f"ALTER TABLE {table_name} "
                "ADD COLUMN IF NOT EXISTS appointment_id INTEGER "
                "REFERENCES appointments(id) ON DELETE SET NULL"
            )
        )



